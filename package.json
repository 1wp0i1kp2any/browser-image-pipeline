{
  "name": "browser-image-pipeline",
  "version": "0.7.0",
  "description": "Браузерный конвейер изображений: кадр → квантование палитры → кодирование, плюс подбор параметров под предикат вызывающего кода",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "require": "./dist/state.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./probe": {
      "types": "./dist/probe.d.ts",
      "import": "./dist/probe.js",
      "require": "./dist/probe.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./src/index.ts",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/bench-strategies.ts",
    "sizes": "tsx scripts/chunk-sizes.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "compare": "tsx scripts/compare-formats.ts",
    "bench:corpus": "tsx scripts/benchmark-corpus.ts",
    "budget": "node scripts/check-bundle-budget.mjs",
    "consumer:smoke": "node scripts/consumer-smoke.mjs",
    "smoke:demo": "node scripts/smoke-demo.mjs",
    "fixtures:browser": "tsx scripts/browser-fixtures.ts",
    "bench:profile": "tsx scripts/benchmark-profile.ts",
    "bench:browser:build": "vite build --config bench/vite.config.ts",
    "bench:browser": "vite build --config bench/vite.config.ts && tsx scripts/benchmark-browser.ts"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "image-q": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "playwright": "^1.64.1",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
